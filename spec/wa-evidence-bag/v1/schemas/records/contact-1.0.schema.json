{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.whatsapp-forensics.invalid/waeb/v1/records/contact-1.0.schema.json",
  "title": "WAEB contact data",
  "type": "object",
  "additionalProperties": false,
  "required": ["nativeIdentities", "displayNames", "about", "isSelf", "isAddressBookContact", "isWhatsAppUser", "isVerified", "isDeactivated", "profileAssetIds"],
  "properties": {
    "nativeIdentities": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "../common-1.0.schema.json#/$defs/nativeIdentity"}
    },
    "displayNames": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formatted", "push", "short", "verified"],
      "properties": {
        "formatted": {"type": ["string", "null"], "maxLength": 512},
        "push": {"type": ["string", "null"], "maxLength": 512},
        "short": {"type": ["string", "null"], "maxLength": 512},
        "verified": {"type": ["string", "null"], "maxLength": 512}
      }
    },
    "about": {"type": ["string", "null"], "maxLength": 2048},
    "isSelf": {"type": "boolean"},
    "isAddressBookContact": {"type": "boolean"},
    "isWhatsAppUser": {"type": "boolean"},
    "isVerified": {"type": "boolean"},
    "isDeactivated": {"type": ["boolean", "null"]},
    "profileAssetIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "../common-1.0.schema.json#/$defs/recordId"}
    }
  }
}
