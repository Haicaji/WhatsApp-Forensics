{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.whatsapp-forensics.invalid/waeb/v1/records/participant-1.0.schema.json",
  "title": "WAEB participant relation data",
  "type": "object",
  "additionalProperties": false,
  "required": ["containerRecordId", "subjectRecordId", "role", "membershipState", "joinedAtUtc", "leftAtUtc"],
  "properties": {
    "containerRecordId": {"$ref": "../common-1.0.schema.json#/$defs/recordId"},
    "subjectRecordId": {"$ref": "../common-1.0.schema.json#/$defs/recordId"},
    "role": {"enum": ["owner", "admin", "member", "subscriber", "unknown"]},
    "membershipState": {"enum": ["active", "left", "removed", "unknown"]},
    "joinedAtUtc": {"type": ["string", "null"], "format": "date-time"},
    "leftAtUtc": {"type": ["string", "null"], "format": "date-time"}
  }
}
