{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.whatsapp-forensics.invalid/waeb/v1/capabilities-1.0.schema.json",
  "title": "WAEB v1 capability probe result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sourceId", "probedAtUtc", "whatsappBuild", "capabilities"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "sourceId": {"$ref": "common-1.0.schema.json#/$defs/uuid"},
    "probedAtUtc": {"$ref": "common-1.0.schema.json#/$defs/utcTimestamp"},
    "whatsappBuild": {"type": "string", "minLength": 1, "maxLength": 160},
    "capabilities": {
      "type": "array",
      "minItems": 19,
      "maxItems": 19,
      "prefixItems": [
        {"$ref": "#/$defs/capability", "properties": {"name": {"const": "accounts"}}},
        {"$ref": "#/$defs/capability", "properties": {"name": {"const": "contacts"}}},
        {"$ref": "#/$defs/capability", "properties": {"name": {"const": "chats"}}},
        {"$ref": "#/$defs/capability", "properties": {"name": {"const": "chat_lists"}}},
        {"$ref": "#/$defs/capability", "properties": {"name": {"const": "participants"}}},
        {"$ref": "#/$defs/capability", "properties": {"name": {"const": "messages"}}},
        {"$ref": "#/$defs/capability", "properties": {"name": {"const": "message_events"}}},
        {"$ref": "#/$defs/capability", "properties": {"name": {"const": "reactions"}}},
        {"$ref": "#/$defs/capability", "properties": {"name": {"const": "receipts"}}},
        {"$ref": "#/$defs/capability", "properties": {"name": {"const": "poll_votes"}}},
        {"$ref": "#/$defs/capability", "properties": {"name": {"const": "group_events"}}},
        {"$ref": "#/$defs/capability", "properties": {"name": {"const": "statuses"}}},
        {"$ref": "#/$defs/capability", "properties": {"name": {"const": "calls"}}},
        {"$ref": "#/$defs/capability", "properties": {"name": {"const": "channels"}}},
        {"$ref": "#/$defs/capability", "properties": {"name": {"const": "channel_events"}}},
        {"$ref": "#/$defs/capability", "properties": {"name": {"const": "communities"}}},
        {"$ref": "#/$defs/capability", "properties": {"name": {"const": "community_relations"}}},
        {"$ref": "#/$defs/capability", "properties": {"name": {"const": "presence_snapshots"}}},
        {"$ref": "#/$defs/capability", "properties": {"name": {"const": "media"}}}
      ],
      "items": false
    }
  },
  "$defs": {
    "reasonCodes": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9_]{3,100}$"}
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "result", "adapter", "reasonCodes"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,100}$"},
        "result": {"enum": ["supported", "unsupported", "degraded", "error"]},
        "adapter": {"type": ["string", "null"], "maxLength": 120},
        "reasonCodes": {"$ref": "#/$defs/reasonCodes"}
      },
      "oneOf": [
        {
          "properties": {
            "result": {"const": "supported"},
            "adapter": {"type": "string", "minLength": 1}
          }
        },
        {
          "properties": {
            "result": {"const": "degraded"},
            "adapter": {"type": "string", "minLength": 1},
            "reasonCodes": {"minItems": 1}
          }
        },
        {
          "properties": {
            "result": {"const": "unsupported"},
            "adapter": {"type": "null"},
            "reasonCodes": {"minItems": 1}
          }
        },
        {
          "properties": {
            "result": {"const": "error"},
            "reasonCodes": {"minItems": 1}
          }
        }
      ]
    }
  }
}
