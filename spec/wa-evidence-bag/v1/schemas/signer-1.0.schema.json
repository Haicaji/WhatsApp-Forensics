{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.whatsapp-forensics.invalid/waeb/v1/signer-1.0.schema.json",
  "title": "WAEB signer public metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "algorithm", "publicKeyFormat", "publicKeySpkiBase64", "publicKeyFingerprint", "keyId", "synthetic"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "algorithm": {"const": "Ed25519"},
    "publicKeyFormat": {"const": "DER-SPKI"},
    "publicKeySpkiBase64": {"type": "string", "pattern": "^[A-Za-z0-9+/]+={0,2}$"},
    "publicKeyFingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "keyId": {"type": "string", "pattern": "^[a-zA-Z0-9_.-]{3,120}$"},
    "synthetic": {"type": "boolean"}
  }
}
