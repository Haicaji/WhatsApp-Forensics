{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.whatsapp-forensics.invalid/waeb/v1/evidence-record-1.0.schema.json",
  "title": "WAEB normalized evidence record envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "recordType", "recordId", "sourceId", "capturedAtUtc", "provenance", "contentSha256", "data"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "recordType": {
      "enum": [
        "account", "contact", "chat", "chat_list", "participant", "message",
        "message_event", "reaction", "receipt", "poll_vote", "group_event", "status",
        "call", "channel", "channel_event", "community", "community_relation",
        "presence_snapshot"
      ]
    },
    "recordId": {"$ref": "common-1.0.schema.json#/$defs/recordId"},
    "sourceId": {"$ref": "common-1.0.schema.json#/$defs/uuid"},
    "capturedAtUtc": {"$ref": "common-1.0.schema.json#/$defs/utcTimestamp"},
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "common-1.0.schema.json#/$defs/provenance"}
    },
    "contentSha256": {"$ref": "common-1.0.schema.json#/$defs/sha256"},
    "data": {"type": "object"},
    "extensions": {"$ref": "common-1.0.schema.json#/$defs/extensions"}
  }
}
