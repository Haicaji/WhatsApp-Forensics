{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.whatsapp-forensics.invalid/waeb/v1/media-record-1.0.schema.json",
  "title": "WAEB media index record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "assetId", "sourceId", "sourceRecordIds", "role", "kind",
    "acquisitionStatus", "cas", "declaredMime", "detectedMime", "detector",
    "suggestedExtension", "originalFileName", "relatedAssetIds", "acquisition"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "assetId": {"$ref": "common-1.0.schema.json#/$defs/recordId"},
    "sourceId": {"$ref": "common-1.0.schema.json#/$defs/uuid"},
    "sourceRecordIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "common-1.0.schema.json#/$defs/recordId"}
    },
    "role": {"enum": ["full", "thumbnail", "transmitted_ciphertext", "decrypted_observable", "avatar"]},
    "kind": {"enum": ["image", "video", "audio", "voice", "document", "sticker", "contact_card", "other"]},
    "acquisitionStatus": {"enum": ["available", "missing", "expired", "decrypt_error", "not_requested"]},
    "cas": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["algorithm", "digest", "path", "byteLength"],
          "properties": {
            "algorithm": {"const": "sha256"},
            "digest": {"$ref": "common-1.0.schema.json#/$defs/sha256"},
            "path": {"type": "string", "pattern": "^data/media/sha256/[0-9a-f]{2}/[0-9a-f]{64}$"},
            "byteLength": {"type": "integer", "minimum": 0}
          }
        }
      ]
    },
    "declaredMime": {"type": ["string", "null"], "maxLength": 160},
    "detectedMime": {"type": ["string", "null"], "maxLength": 160},
    "detector": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 120},
        "version": {"type": "string", "minLength": 1, "maxLength": 80}
      }
    },
    "suggestedExtension": {"type": ["string", "null"], "pattern": "^\\.[a-z0-9]{1,16}$"},
    "originalFileName": {"type": ["string", "null"], "maxLength": 512},
    "width": {"type": ["integer", "null"], "minimum": 0},
    "height": {"type": ["integer", "null"], "minimum": 0},
    "durationMs": {"type": ["integer", "null"], "minimum": 0},
    "relatedAssetIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "common-1.0.schema.json#/$defs/recordId"}
    },
    "acquisition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "attempts", "capturedAtUtc", "errorCode"],
      "properties": {
        "method": {"enum": ["blob_observed", "media_download", "media_decrypt", "inline_preview", "not_attempted"]},
        "attempts": {"type": "integer", "minimum": 0},
        "capturedAtUtc": {"type": ["string", "null"], "format": "date-time"},
        "errorCode": {"type": ["string", "null"], "pattern": "^[a-z0-9_]{3,100}$"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"acquisitionStatus": {"const": "available"}}},
      "then": {"properties": {"cas": {"type": "object"}}},
      "else": {"properties": {"cas": {"type": "null"}}}
    }
  ]
}
