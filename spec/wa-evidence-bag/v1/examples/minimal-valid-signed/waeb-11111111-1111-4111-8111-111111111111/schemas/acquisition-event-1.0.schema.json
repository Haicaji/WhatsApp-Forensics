{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.whatsapp-forensics.invalid/waeb/v1/acquisition-event-1.0.schema.json",
  "title": "WAEB acquisition log event",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sequence", "sessionId", "wallClockUtc", "monotonicOffsetNs", "previousEventHash", "event", "eventHash"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "sequence": {"$ref": "common-1.0.schema.json#/$defs/decimalInteger"},
    "sessionId": {"$ref": "common-1.0.schema.json#/$defs/uuid"},
    "wallClockUtc": {"$ref": "common-1.0.schema.json#/$defs/utcTimestamp"},
    "monotonicOffsetNs": {"$ref": "common-1.0.schema.json#/$defs/decimalInteger"},
    "previousEventHash": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "common-1.0.schema.json#/$defs/sha256"}
      ]
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "summary"],
      "properties": {
        "type": {
          "enum": [
            "acquisition_started", "acquisition_resumed", "capability_probe_completed",
            "phase_started", "dataset_completed", "media_attempt", "checkpoint_written",
            "warning", "acquisition_completed"
          ]
        },
        "summary": {
          "type": "object",
          "maxProperties": 30,
          "propertyNames": {"pattern": "^[a-z][a-zA-Z0-9_]{0,79}$"},
          "additionalProperties": {
            "type": ["string", "number", "integer", "boolean", "null", "array"],
            "items": {"type": ["string", "number", "integer", "boolean", "null"]}
          }
        }
      }
    },
    "eventHash": {"$ref": "common-1.0.schema.json#/$defs/sha256"}
  }
}
