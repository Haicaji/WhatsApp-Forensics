{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.whatsapp-forensics.invalid/waeb/v1/raw-record-1.0.schema.json",
  "title": "WAEB whitelisted raw record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "recordId", "provider", "phase", "capturedAtUtc", "nativeType", "value", "omittedFields", "contentSha256"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "recordId": {"$ref": "common-1.0.schema.json#/$defs/recordId"},
    "provider": {"enum": ["store", "indexeddb", "dom_validation"]},
    "phase": {"enum": ["baseline", "enriched"]},
    "capturedAtUtc": {"$ref": "common-1.0.schema.json#/$defs/utcTimestamp"},
    "nativeType": {"type": "string", "minLength": 1, "maxLength": 160},
    "value": {},
    "omittedFields": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-zA-Z0-9_.-]{1,160}$"}
    },
    "contentSha256": {"$ref": "common-1.0.schema.json#/$defs/sha256"}
  }
}
