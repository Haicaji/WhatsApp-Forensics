{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.whatsapp-forensics.invalid/waeb/v1/records/message-1.0.schema.json",
  "title": "WAEB message-like data",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "nativeIdentity", "container", "senderRecordId", "recipientRecordIds", "authorRecordId",
    "sentAt", "kind", "nativeType", "text", "caption", "quoted", "mentionRecordIds",
    "flags", "acknowledgement", "attachmentAssetIds", "location", "poll", "event",
    "unsupportedReasonCodes"
  ],
  "properties": {
    "nativeIdentity": {"$ref": "../common-1.0.schema.json#/$defs/nativeIdentity"},
    "container": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "recordId"],
      "properties": {
        "kind": {"enum": ["chat", "status_thread", "channel"]},
        "recordId": {"$ref": "../common-1.0.schema.json#/$defs/recordId"}
      }
    },
    "senderRecordId": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "../common-1.0.schema.json#/$defs/recordId"}
      ]
    },
    "recipientRecordIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "../common-1.0.schema.json#/$defs/recordId"}
    },
    "authorRecordId": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "../common-1.0.schema.json#/$defs/recordId"}
      ]
    },
    "sentAt": {"$ref": "#/$defs/observedTime"},
    "kind": {
      "enum": [
        "text", "image", "video", "audio", "voice", "document", "sticker",
        "contact_card", "location", "poll", "event", "system", "call_event",
        "revoked", "unknown"
      ]
    },
    "nativeType": {"type": "string", "minLength": 1, "maxLength": 160},
    "text": {"type": ["string", "null"], "maxLength": 1048576},
    "caption": {"type": ["string", "null"], "maxLength": 1048576},
    "quoted": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["resolution", "messageRecordId", "nativeIdentity", "participantRecordId"],
          "properties": {
            "resolution": {"enum": ["resolved", "unresolved", "not_observed"]},
            "messageRecordId": {
              "oneOf": [
                {"type": "null"},
                {"$ref": "../common-1.0.schema.json#/$defs/recordId"}
              ]
            },
            "nativeIdentity": {
              "oneOf": [
                {"type": "null"},
                {"$ref": "../common-1.0.schema.json#/$defs/nativeIdentity"}
              ]
            },
            "participantRecordId": {
              "oneOf": [
                {"type": "null"},
                {"$ref": "../common-1.0.schema.json#/$defs/recordId"}
              ]
            }
          }
        }
      ]
    },
    "mentionRecordIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "../common-1.0.schema.json#/$defs/recordId"}
    },
    "flags": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fromMe", "forwarded", "starred", "edited", "revoked", "viewOnce", "ephemeral"],
      "properties": {
        "fromMe": {"type": "boolean"},
        "forwarded": {"type": "boolean"},
        "starred": {"type": "boolean"},
        "edited": {"type": "boolean"},
        "revoked": {"type": "boolean"},
        "viewOnce": {"type": "boolean"},
        "ephemeral": {"type": "boolean"}
      }
    },
    "acknowledgement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "nativeValue"],
      "properties": {
        "state": {"enum": ["unknown", "pending", "sent", "delivered", "read", "played", "failed"]},
        "nativeValue": {"type": ["string", "number", "null"]}
      }
    },
    "attachmentAssetIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "../common-1.0.schema.json#/$defs/recordId"}
    },
    "location": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["latitude", "longitude", "name", "address"],
          "properties": {
            "latitude": {"type": "number", "minimum": -90, "maximum": 90},
            "longitude": {"type": "number", "minimum": -180, "maximum": 180},
            "name": {"type": ["string", "null"], "maxLength": 512},
            "address": {"type": ["string", "null"], "maxLength": 2048}
          }
        }
      ]
    },
    "poll": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "options", "selectableCount", "closed"],
          "properties": {
            "name": {"type": "string", "maxLength": 4096},
            "options": {"type": "array", "items": {"type": "string", "maxLength": 1024}},
            "selectableCount": {"type": "integer", "minimum": 1},
            "closed": {"type": ["boolean", "null"]}
          }
        }
      ]
    },
    "event": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "description", "startsAtUtc", "canceled"],
          "properties": {
            "name": {"type": "string", "maxLength": 4096},
            "description": {"type": ["string", "null"], "maxLength": 65536},
            "startsAtUtc": {"type": ["string", "null"], "format": "date-time"},
            "canceled": {"type": ["boolean", "null"]}
          }
        }
      ]
    },
    "unsupportedReasonCodes": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9_]{3,100}$"}
    }
  },
  "$defs": {
    "observedTime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["utc", "originalValue", "originalUnit", "source", "precision"],
      "properties": {
        "utc": {"$ref": "../common-1.0.schema.json#/$defs/utcTimestamp"},
        "originalValue": {"type": ["string", "null"], "maxLength": 160},
        "originalUnit": {"enum": ["seconds", "milliseconds", "microseconds", "native_unknown", "not_available"]},
        "source": {"enum": ["message_store", "indexeddb", "dom", "derived"]},
        "precision": {"enum": ["second", "millisecond", "unknown"]}
      }
    }
  }
}
