{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.whatsapp-forensics.invalid/waeb/v1/seal-1.0.schema.json",
  "title": "WAEB v1 required signed seal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "waEvidenceBagVersion", "evidenceId", "createdAtUtc",
    "manifestRootSha256", "payloadManifests", "tagFiles", "signature"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "waEvidenceBagVersion": {"const": "1.0.0-draft.1"},
    "evidenceId": {"$ref": "common-1.0.schema.json#/$defs/uuid"},
    "createdAtUtc": {"$ref": "common-1.0.schema.json#/$defs/utcTimestamp"},
    "manifestRootSha256": {"$ref": "common-1.0.schema.json#/$defs/sha256"},
    "payloadManifests": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {"$ref": "#/$defs/fileDigest", "properties": {"path": {"const": "manifest-sha256.txt"}}},
        {"$ref": "#/$defs/fileDigest", "properties": {"path": {"const": "manifest-sha512.txt"}}}
      ],
      "items": false
    },
    "tagFiles": {
      "type": "array",
      "minItems": 25,
      "maxItems": 25,
      "prefixItems": [
        {"$ref": "#/$defs/fileDigest", "properties": {"path": {"const": "bag-info.txt"}}},
        {"$ref": "#/$defs/fileDigest", "properties": {"path": {"const": "bagit.txt"}}},
        {"$ref": "#/$defs/fileDigest", "properties": {"path": {"const": "schemas/acquisition-1.0.schema.json"}}},
        {"$ref": "#/$defs/fileDigest", "properties": {"path": {"const": "schemas/acquisition-event-1.0.schema.json"}}},
        {"$ref": "#/$defs/fileDigest", "properties": {"path": {"const": "schemas/capabilities-1.0.schema.json"}}},
        {"$ref": "#/$defs/fileDigest", "properties": {"path": {"const": "schemas/chat-completeness-1.0.schema.json"}}},
        {"$ref": "#/$defs/fileDigest", "properties": {"path": {"const": "schemas/common-1.0.schema.json"}}},
        {"$ref": "#/$defs/fileDigest", "properties": {"path": {"const": "schemas/completeness-1.0.schema.json"}}},
        {"$ref": "#/$defs/fileDigest", "properties": {"path": {"const": "schemas/dataset-inventory-1.0.schema.json"}}},
        {"$ref": "#/$defs/fileDigest", "properties": {"path": {"const": "schemas/evidence-record-1.0.schema.json"}}},
        {"$ref": "#/$defs/fileDigest", "properties": {"path": {"const": "schemas/index.json"}}},
        {"$ref": "#/$defs/fileDigest", "properties": {"path": {"const": "schemas/media-record-1.0.schema.json"}}},
        {"$ref": "#/$defs/fileDigest", "properties": {"path": {"const": "schemas/raw-record-1.0.schema.json"}}},
        {"$ref": "#/$defs/fileDigest", "properties": {"path": {"const": "schemas/records/account-1.0.schema.json"}}},
        {"$ref": "#/$defs/fileDigest", "properties": {"path": {"const": "schemas/records/chat-1.0.schema.json"}}},
        {"$ref": "#/$defs/fileDigest", "properties": {"path": {"const": "schemas/records/chat-list-1.0.schema.json"}}},
        {"$ref": "#/$defs/fileDigest", "properties": {"path": {"const": "schemas/records/contact-1.0.schema.json"}}},
        {"$ref": "#/$defs/fileDigest", "properties": {"path": {"const": "schemas/records/event-1.0.schema.json"}}},
        {"$ref": "#/$defs/fileDigest", "properties": {"path": {"const": "schemas/records/generic-entity-1.0.schema.json"}}},
        {"$ref": "#/$defs/fileDigest", "properties": {"path": {"const": "schemas/records/message-1.0.schema.json"}}},
        {"$ref": "#/$defs/fileDigest", "properties": {"path": {"const": "schemas/records/participant-1.0.schema.json"}}},
        {"$ref": "#/$defs/fileDigest", "properties": {"path": {"const": "schemas/records/relation-1.0.schema.json"}}},
        {"$ref": "#/$defs/fileDigest", "properties": {"path": {"const": "schemas/seal-1.0.schema.json"}}},
        {"$ref": "#/$defs/fileDigest", "properties": {"path": {"const": "schemas/signer-1.0.schema.json"}}},
        {"$ref": "#/$defs/fileDigest", "properties": {"path": {"const": "signatures/signer.json"}}}
      ],
      "items": false
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "signerFingerprint", "signaturePath", "signedBytes"],
      "properties": {
        "algorithm": {"const": "Ed25519"},
        "signerFingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "signaturePath": {"const": "signatures/seal.ed25519"},
        "signedBytes": {"const": "exact-seal-json-utf8"}
      }
    }
  },
  "$defs": {
    "fileDigest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "common-1.0.schema.json#/$defs/safeRelativePath"},
        "sha256": {"$ref": "common-1.0.schema.json#/$defs/sha256"}
      }
    }
  }
}
