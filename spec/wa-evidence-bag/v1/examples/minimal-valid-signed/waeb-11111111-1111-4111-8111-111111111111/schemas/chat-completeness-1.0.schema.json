{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.whatsapp-forensics.invalid/waeb/v1/chat-completeness-1.0.schema.json",
  "title": "WAEB per-chat completeness record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "sourceId", "chatRecordId", "discoverySources", "initialMessageCount",
    "finalMessageCount", "historyScope", "loadMethod", "rounds", "returnedCount",
    "newCount", "emptyRounds", "stagnantRounds", "earliestObservedAtUtc",
    "latestObservedAtUtc", "terminationEvidence", "reasonCodes"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "sourceId": {"$ref": "common-1.0.schema.json#/$defs/uuid"},
    "chatRecordId": {"$ref": "common-1.0.schema.json#/$defs/recordId"},
    "discoverySources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["store", "indexeddb", "visible_list", "active_chat", "history_loader"]}
    },
    "initialMessageCount": {"type": "integer", "minimum": 0},
    "finalMessageCount": {"type": "integer", "minimum": 0},
    "historyScope": {"enum": ["terminal_observed", "stable_no_growth", "limit_reached", "loader_error", "not_run"]},
    "loadMethod": {"enum": ["store_loader", "ui_fallback", "none"]},
    "rounds": {"type": "integer", "minimum": 0},
    "returnedCount": {"type": "integer", "minimum": 0},
    "newCount": {"type": "integer", "minimum": 0},
    "emptyRounds": {"type": "integer", "minimum": 0},
    "stagnantRounds": {"type": "integer", "minimum": 0},
    "earliestObservedAtUtc": {"type": ["string", "null"], "format": "date-time"},
    "latestObservedAtUtc": {"type": ["string", "null"], "format": "date-time"},
    "terminationEvidence": {"type": ["string", "null"], "maxLength": 300},
    "reasonCodes": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9_]{3,100}$"}
    }
  }
}
