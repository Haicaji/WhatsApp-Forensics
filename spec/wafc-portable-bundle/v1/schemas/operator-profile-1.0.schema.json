{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wafc.local/spec/portable/v1/schemas/operator-profile-1.0.schema.json",
  "title": "WAFC operator profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "operatorId",
    "displayName",
    "organization",
    "keyId",
    "evidenceSigningKeyFingerprintSha256"
  ],
  "properties": {
    "schemaVersion": { "const": "wafc-operator-profile/1" },
    "operatorId": { "$ref": "common-1.0.schema.json#/$defs/identifier" },
    "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
    "organization": { "type": "string", "minLength": 1, "maxLength": 240 },
    "keyId": { "$ref": "common-1.0.schema.json#/$defs/identifier" },
    "evidenceSigningKeyFingerprintSha256": {
      "$ref": "common-1.0.schema.json#/$defs/fingerprint"
    }
  }
}
