{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wafc.local/spec/portable/v1/schemas/portable-root-1.0.schema.json",
  "title": "WAFC portable-root marker",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "layout", "bundleId", "paths"],
  "properties": {
    "schemaVersion": { "const": "wafc-portable/1" },
    "layout": { "const": "wafc-usb-v1" },
    "bundleId": {
      "$ref": "common-1.0.schema.json#/$defs/uuid"
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest",
        "operatorProfile",
        "operatorKey",
        "workstationTrust",
        "assignments",
        "evidenceStaging",
        "evidenceSealed",
        "handoff",
        "diagnostics"
      ],
      "properties": {
        "manifest": { "const": "config/bundle-manifest.json" },
        "operatorProfile": { "const": "config/operator-profile.json" },
        "operatorKey": { "const": "config/operator-key.enc" },
        "workstationTrust": { "const": "config/workstation-trust.json" },
        "assignments": { "const": "assignments" },
        "evidenceStaging": { "const": "evidence/staging" },
        "evidenceSealed": { "const": "evidence/sealed" },
        "handoff": { "const": "handoff" },
        "diagnostics": { "const": "diagnostics" }
      }
    }
  }
}
