{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wafc.local/spec/portable/v1/schemas/bundle-manifest-1.0.schema.json",
  "title": "WAFC signed portable bundle manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "payload", "signature"],
  "properties": {
    "schemaVersion": { "const": "wafc-portable-bundle-manifest/1" },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bundleId",
        "createdAtUtc",
        "operatorId",
        "operatorKeyId",
        "workstationKeyId",
        "files"
      ],
      "properties": {
        "bundleId": { "$ref": "common-1.0.schema.json#/$defs/uuid" },
        "createdAtUtc": { "$ref": "common-1.0.schema.json#/$defs/utcDateTime" },
        "operatorId": { "$ref": "common-1.0.schema.json#/$defs/identifier" },
        "operatorKeyId": { "$ref": "common-1.0.schema.json#/$defs/identifier" },
        "workstationKeyId": { "$ref": "common-1.0.schema.json#/$defs/identifier" },
        "files": {
          "type": "array",
          "minItems": 5,
          "maxItems": 1000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "bytes", "sha256"],
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^(wafc-portable\\.json|config/operator-profile\\.json|config/operator-key\\.enc|config/workstation-trust\\.json|assignments/assignment-[A-Za-z0-9_.-]+\\.json)$",
                "maxLength": 240
              },
              "bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "sha256": { "$ref": "common-1.0.schema.json#/$defs/sha256" }
            }
          }
        }
      }
    },
    "signature": {
      "$ref": "common-1.0.schema.json#/$defs/signature"
    }
  }
}
