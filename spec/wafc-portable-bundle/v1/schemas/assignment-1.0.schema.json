{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wafc.local/spec/portable/v1/schemas/assignment-1.0.schema.json",
  "title": "WAFC signed field assignment",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "payload", "signature"],
  "properties": {
    "schemaVersion": { "const": "wafc-assignment/1" },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assignmentId",
        "authorizationReference",
        "operatorId",
        "allowedKeyId",
        "sourceOrganization",
        "issuedAtUtc",
        "validFromUtc",
        "validUntilUtc",
        "acquisitionMode",
        "mediaPolicy",
        "targetDescription"
      ],
      "properties": {
        "assignmentId": { "$ref": "common-1.0.schema.json#/$defs/identifier" },
        "authorizationReference": { "type": "string", "minLength": 1, "maxLength": 240 },
        "operatorId": { "$ref": "common-1.0.schema.json#/$defs/identifier" },
        "allowedKeyId": { "$ref": "common-1.0.schema.json#/$defs/identifier" },
        "sourceOrganization": { "type": "string", "minLength": 1, "maxLength": 240 },
        "issuedAtUtc": { "$ref": "common-1.0.schema.json#/$defs/utcDateTime" },
        "validFromUtc": { "$ref": "common-1.0.schema.json#/$defs/utcDateTime" },
        "validUntilUtc": { "$ref": "common-1.0.schema.json#/$defs/utcDateTime" },
        "acquisitionMode": {
          "enum": ["passive_t0", "comprehensive_readonly_v02"]
        },
        "mediaPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "maxAssetBytes",
            "maxTotalBytes",
            "cacheLookupTimeoutSeconds",
            "noProgressTimeoutSeconds",
            "attemptTimeoutSeconds",
            "maxAssetDurationSeconds",
            "maxAttempts",
            "continueOnFailure"
          ],
          "properties": {
            "mode": {"enum": ["cached_only", "network_best_effort", "metadata_only"]},
            "maxAssetBytes": {"type": "integer", "minimum": 1, "maximum": 34359738368},
            "maxTotalBytes": {"type": "integer", "minimum": 1, "maximum": 35184372088832},
            "cacheLookupTimeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 300},
            "noProgressTimeoutSeconds": {"type": "integer", "minimum": 5, "maximum": 3600},
            "attemptTimeoutSeconds": {"type": "integer", "minimum": 5, "maximum": 7200},
            "maxAssetDurationSeconds": {"type": "integer", "minimum": 5, "maximum": 86400},
            "maxAttempts": {"type": "integer", "minimum": 1, "maximum": 5},
            "continueOnFailure": {"type": "boolean"}
          }
        },
        "targetDescription": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    },
    "signature": {
      "$ref": "common-1.0.schema.json#/$defs/signature"
    }
  }
}
